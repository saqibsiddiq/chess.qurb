{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeAndReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetConsoleOutput",
        "ec2:GetSpotPlacementScores"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchOnlyCheapApprovedInstanceTypes",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:RequestSpotInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": [
            "t3.micro",
            "t3.small",
            "g4dn.xlarge",
            "g4dn.2xlarge"
          ],
          "aws:RequestedRegion": ["us-east-1"]
        }
      }
    },
    {
      "Sid": "LaunchSupportingResources",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:RequestSpotInstances"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:*:key-pair/*",
        "arn:aws:ec2:us-east-1:*:security-group/*",
        "arn:aws:ec2:us-east-1:*:network-interface/*",
        "arn:aws:ec2:us-east-1:*:subnet/*",
        "arn:aws:ec2:us-east-1:*:volume/*"
      ]
    },
    {
      "Sid": "ManageOwnInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:StartInstances",
        "ec2:RebootInstances",
        "ec2:CreateTags",
        "ec2:CreateKeyPair",
        "ec2:DeleteKeyPair",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:CreateVolume",
        "ec2:DeleteVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:CreateSnapshot",
        "ec2:DeleteSnapshot",
        "ec2:CancelSpotInstanceRequests"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ["us-east-1"]
        }
      }
    }
  ]
}
